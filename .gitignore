
# =========================
# 共通: 一時ファイル / キャッシュ
# =========================
*.log
*.tmp
*.bak
*.swp
*.pyc
*.pyo
*.class
__pycache__/
.venv/
.codex-tmp/
*.gpkg
*.tif
*.tiff

# =========================
# 研究データ: 外部管理対象
# =========================
SSD/
整備データ/

# =========================
# 認証情報（絶対に追跡しない）
# =========================
# APIトークン等の秘密情報はリポジトリ直下の .env に集約する。
# 記載すべき変数は追跡対象の .env.example を参照（値は空のテンプレート）。
.env
.env.*
!.env.example

# =========================
# 生成物: 再生成可能な出力は追跡しない
# =========================
data/output/satellite_only/*/*_dataset.csv
data/output/satellite_only/*/*_sample_*.csv
data/output/satellite_only_cellbased/*/*_sample_*.csv
data/output/limited/*/*_sample_*.csv
data/output/urban_params/*.csv

# GIS空間データ（大容量）は追跡しない
data/gis/

# 衛星データ（大容量ラスタ）は追跡しない
data/satellite/

# GIS補助ファイル
*.aux
*.aux.xml

# PDFは原則追跡しない（文献はメタデータで管理）
*.pdf

# QGISプロジェクトファイル（qgis/projects/ 配下はローカルのみ、qgis/styles・qgis/templates は追跡）
*.qgz
qgis/projects/

# =========================
# 例外: 共有用サンプルは追跡可
# =========================
!data/samples/
!data/samples/**

# BSHorizon出力テキスト（大容量）
data/BSHorizon/output/*.txt

# BSHorizon入力CSV（正本 data/output/survey_translated/ から
# prepare_bs_horizon_input.py で再生成可能なため追跡外）
data/BSHorizon/input/merge_DH_elevation_points.csv

# =========================
# 個人用作業メモ（Git追跡外）
# =========================
notes/

# =========================
# 進捗報告資料（バイナリ・再生成可能なため追跡外）
# =========================
presentations/

# =========================
# Claude Code: 個人環境設定（環境依存の許可はここに置く）
# =========================
.claude/settings.local.json
# settings.local.json から呼ぶフック。クライアント側の不具合の回避など
# 環境依存の内容になるため、共有しない
.claude/hooks/

# =========================
# 探索・単発スクリプト（テスト不要領域。再利用時は src/ へ昇格）
# =========================
sandbox/
