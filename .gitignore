
# =========================
# 共通: 一時ファイル / キャッシュ
# =========================
*.log
*.tmp
*.bak
*.swp
*.pyc
*.pyo
*.class
__pycache__/
.venv/
.codex-tmp/
*.gpkg
*.tif
*.tiff

# =========================
# 研究データ: 外部管理対象
# =========================
SSD/
整備データ/

# =========================
# 生成物: 再生成可能な出力は追跡しない
# =========================
data/csv/analysis/*_dataset.csv
data/csv/analysis/urban_params_*.csv

# GIS空間データ（大容量）は追跡しない
data/gis/

# 衛星データ（大容量ラスタ）は追跡しない
data/satellite/

# GIS補助ファイル
*.aux
*.aux.xml

# PDFは原則追跡しない（文献はメタデータで管理）
*.pdf

# QGISプロジェクトファイル（qgis/projects/ 配下はローカルのみ、qgis/styles・qgis/templates は追跡）
*.qgz
qgis/projects/

# =========================
# 例外: 共有用サンプルは追跡可
# =========================
!data/samples/
!data/samples/**

# BSHorizon出力テキスト（大容量）
data/BSHorizon/output/*.txt

# =========================
# 個人用作業メモ（Git追跡外）
# =========================
notes/

# =========================
# 進捗報告資料（バイナリ・再生成可能なため追跡外）
# =========================
presentations/

# =========================
# Claude Code: 個人環境設定（環境依存の許可はここに置く）
# =========================
.claude/settings.local.json

# =========================
# 探索・単発スクリプト（テスト不要領域。再利用時は src/ へ昇格）
# =========================
sandbox/
