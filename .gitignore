*.log
*.tmp
*.bak
*.swp
*.pyc
*.pyo
*.class
__pycache__/
.venv/
.codex-tmp/
*.gpkg
*.tif
*.tiff

# =========================
# 研究データ: 外部管理対象
# =========================
QGIS/
SSD/
整備データ/

# =========================
# 生成物: 再生成可能な出力は追跡しない
# =========================
data/csv/analysis/*_dataset.csv
data/csv/analysis/urban_params_*.csv

# GIS空間データ（大容量）は追跡しない
data/gis/

# 衛星データ（大容量ラスタ）は追跡しない
data/satellite/

# GIS補助ファイル
*.aux
*.aux.xml

# PDFは原則追跡しない（文献はメタデータで管理）
*.pdf

# QGISプロジェクトファイル
*.qgz

# =========================
# 例外: 共有用サンプルは追跡可
# =========================
!data/samples/
!data/samples/**

# BSHorizon出力テキスト（大容量）
data/BSHorizon/output/*.txt
